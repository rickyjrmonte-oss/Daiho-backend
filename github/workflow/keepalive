name: Keep Alive Render

on:
  schedule:
    - cron: "*/5 * * * *"   # every 10 minutes
  workflow_dispatch:         # manual run button

jobs:
  ping:
    runs-on: ubuntu-latest
    steps:
      - name: Curl health endpoint
        run: |
          set -e
          RESP=$(curl -s -o /dev/null -w "%{http_code}" "https://daiho-auto-parts-2.onrender.com/health")
          echo "HTTP status: $RESP"
          if [ "$RESP" -ne 200 ]; then
            echo "Health check failed"
            exit 1
          fi
